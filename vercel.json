{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    },
    {
      "source": "/((?!api/|assets/|src/assets/|manifest\\.webmanifest|sw\\.js|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
